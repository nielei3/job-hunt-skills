# Optional: local project overrides. Hermes runtime still reads ~/.hermes/.env first.

# IMAP source for LinkedIn Job Alert emails
JOB_ALERT_IMAP_HOST=
JOB_ALERT_IMAP_PORT=993
JOB_ALERT_IMAP_USER=
JOB_ALERT_IMAP_PASSWORD=
JOB_ALERT_IMAP_FOLDER=INBOX
JOB_ALERT_LOOKBACK_DAYS=3
JOB_ALERT_UNREAD_ONLY=true
JOB_ALERT_MAX_MESSAGES=25

# Optional local testing mode: folder of .eml files instead of IMAP
# JOB_ALERT_LOCAL_EML_DIR=/absolute/path/to/test-emails

# External JD enrichment
JOB_HTTP_TIMEOUT_SECONDS=20
JOB_EXTERNAL_SEARCH_ENABLED=false
# JOB_SEARCH_SITE_FILTERS=site:greenhouse.io site:lever.co site:ashbyhq.com site:myworkdayjobs.com site:smartrecruiters.com
